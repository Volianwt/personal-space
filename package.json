{
  "name": "tao-personal-space",
  "private": true,
  "version": "2.0.1",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts tests/*.test.mjs",
    "build": "npm run typecheck && vite build && node scripts/export-preview.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "format": "prettier --write src server tests scripts docs README.md START_HERE.md index.html vite.config.ts tsconfig.json package.json",
    "start": "node server/index.mjs",
    "api": "node server/index.mjs"
  },
  "dependencies": {
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "lucide-react": "0.546.0"
  },
  "devDependencies": {
    "@types/react": "19.2.6",
    "@vitejs/plugin-react": "5.2.0",
    "typescript": "5.9.3",
    "vite": "6.4.1",
    "prettier": "3.8.1"
  }
}
